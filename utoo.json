{
  "$schema": "https://raw.githubusercontent.com/fireairforce/utoo-lint/main/npm/utoo-lint/schema.json",
  "files": [
    "src/**/*.{js,jsx,ts,tsx,mjs,cjs}",
    "scripts/**/*.{js,jsx,ts,tsx,mjs,cjs}",
    "test/**/*.{js,jsx,ts,tsx,mjs,cjs}",
    "fixtures/**/*.{js,jsx,ts,tsx,mjs,cjs}"
  ],
  "ignores": ["candidate-artifacts", "node_modules", "workspace"],
  "rules": {
    "no-debugger": "error",
    "no-unused-vars": "error",
    "prefer-const": "error",
    "eqeqeq": "error",
    "use-isnan": "error",
    "valid-typeof": "error",
    "no-constant-condition": "error",
    "no-dupe-keys": "error",
    "no-duplicate-imports": "error"
  }
}
